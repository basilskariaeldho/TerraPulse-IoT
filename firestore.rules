rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt']);
      allow delete: if false;

      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['name', 'channelId', 'readApiKey', 'isPublic', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.channelId is string
          && request.resource.data.readApiKey is string
          && request.resource.data.isPublic is bool;
        allow delete: if isOwner(userId);
      }
    }
  }
}
